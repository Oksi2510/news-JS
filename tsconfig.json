{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",

        "module": "ESNext",
        "target": "esnext",

        "sourceMap": true,

        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        "strict": true,
        "noImplicitAny": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    }
}
